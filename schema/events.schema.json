{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nexus://events.schema.json",
  "title": "NEXUS HUD Event-Schema",
  "description": "Single source of truth für die IPC-Verträge (JSON-RPC 2.0). Alle Module validieren ihre Events gegen diese Definition. Siehe ARCHITECTURE.md Abschnitt 3.",
  "type": "object",
  "required": ["jsonrpc", "method", "params"],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "description": "Requests haben eine id (erwarten Antwort), Notifications/Events nicht.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "event.system.hello",
        "event.system.heartbeat",
        "event.system.metrics",
        "event.build.failed",
        "event.build.succeeded",
        "event.git.status",
        "event.media.state",
        "event.presence.changed",
        "event.profile.switched",
        "event.hotkey.triggered",
        "event.process.started",
        "event.window.moved",
        "event.automation.started",
        "event.automation.finished",
        "event.file.changed",
        "event.ide.focus",
        "event.clipboard.changed",
        "event.call.initiated",
        "event.call.ended",
        "event.call.status",
        "event.automation.rule.triggered",
        "cmd.media.toggle",
        "cmd.media.next",
        "cmd.media.volume",
        "cmd.media.set_activity",
        "cmd.app.launch",
        "cmd.hotkey.register",
        "cmd.window.move",
        "cmd.window.focus",
        "cmd.automation.run",
        "cmd.metrics.set_interval",
        "cmd.git.watch",
        "cmd.clipboard.set",
        "cmd.clipboard.get_history",
        "cmd.call.make",
        "cmd.call.hangup",
        "cmd.call.status",
        "cmd.profile.switch",
        "error.protocol"
      ]
    },
    "params": {
      "type": "object",
      "required": ["source", "protocol_version"],
      "properties": {
        "source": {
          "description": "Absendendes Modul (S-A bis S-E) oder der IPC-Bus.",
          "type": "string",
          "pattern": "^(S-[A-E]|bus)$"
        },
        "protocol_version": {
          "description": "Version des IPC-Protokolls (aktuell 1).",
          "const": 1
        },
        "service_id": {
          "description": "Eindeutige ID des sendenden Services (z.B. bei event.system.hello).",
          "type": "string"
        },
        "ts": {
          "description": "Zeitstempel als ISO-8601-String (RFC3339).",
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "event.system.hello" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["service_id", "version", "ts"],
            "properties": {
              "version": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.system.metrics" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["cpu", "ram", "ts"],
            "properties": {
              "cpu": { "description": "CPU-Auslastung in Prozent.", "type": "number" },
              "gpu_temp_c": { "description": "GPU-Temperatur in Grad Celsius.", "type": "number" },
              "ram": {
                "type": "object",
                "required": ["used_mb", "total_mb"],
                "properties": {
                  "used_mb": { "type": "number" },
                  "total_mb": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "method": { "enum": ["event.build.failed", "event.build.succeeded"] } }
      },
      "then": {
        "properties": {
          "params": {
            "required": ["project", "ok", "ts"],
            "properties": {
              "project": { "description": "Name des gebauten Projekts.", "type": "string" },
              "ok": { "description": "true bei Erfolg, false bei Fehler.", "type": "boolean" },
              "task": { "description": "Optionaler Name der Build-Aufgabe.", "type": "string" },
              "duration_ms": { "description": "Build-Dauer in Millisekunden.", "type": "number" },
              "output": { "description": "Letzte Log-Zeile bzw. Fehlerausgabe.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.git.status" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["repo_path", "branch", "ts"],
            "properties": {
              "repo_path": { "description": "Absoluter Pfad des Git-Repos.", "type": "string" },
              "branch": { "description": "Aktiver Branch (leer bei detached HEAD).", "type": "string" },
              "staged": { "description": "Anzahl gestagter Änderungen.", "type": "integer", "minimum": 0 },
              "uncommitted": { "description": "Anzahl uncommitteter Änderungen.", "type": "integer", "minimum": 0 },
              "ahead": { "description": "Commits vor dem Upstream.", "type": "integer", "minimum": 0 },
              "behind": { "description": "Commits hinter dem Upstream.", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.file.changed" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["path", "change", "ts"],
            "properties": {
              "path": { "description": "Absoluter Pfad der geänderten Datei.", "type": "string" },
              "change": {
                "type": "string",
                "enum": ["create", "write", "remove", "rename", "chmod"]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.automation.started" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["id", "name", "ts"],
            "properties": {
              "id": { "description": "Eindeutige Ausführungs-ID.", "type": "string" },
              "name": { "description": "Name des Tasks.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.automation.finished" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["id", "name", "exit_code", "ts"],
            "properties": {
              "id": { "description": "Eindeutige Ausführungs-ID.", "type": "string" },
              "name": { "description": "Name des Tasks.", "type": "string" },
              "exit_code": { "description": "Exit-Code des ausgeführten Prozesses.", "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.media.state" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["playing", "ts"],
            "properties": {
              "playing": { "description": "true bei Wiedergabe, false bei Pause.", "type": "boolean" },
              "track": { "description": "Name des aktuellen Tracks.", "type": "string" },
              "artist": { "description": "Künstlername(n), kommagetrennt.", "type": "string" },
              "album": { "description": "Albumname.", "type": "string" },
              "album_art_url": { "description": "URL zum Album-Cover.", "type": "string" },
              "duration_ms": { "description": "Track-Dauer in Millisekunden.", "type": "integer" },
              "progress_ms": { "description": "Wiedergabeposition in Millisekunden.", "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.presence.changed" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["service", "status", "ts"],
            "properties": {
              "service": { "description": "Name des Third-Party-Services (discord, whatsapp).", "type": "string" },
              "status": { "description": "Aktueller Status.", "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
              "activity": { "description": "Aktuelle Aktivitaet.", "type": "string" },
              "activity_type": { "description": "Art der Aktivitaet.", "type": "string", "enum": ["playing", "streaming", "listening", "watching", "competing"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.profile.switched" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["profile", "ts"],
            "properties": {
              "profile": { "description": "Name des neuen Profils (dev, gaming, afk).", "type": "string", "enum": ["dev", "gaming", "afk"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.call.initiated" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["call_id", "to", "status", "ts"],
            "properties": {
              "call_id": { "description": "Eindeutige Anruf-ID.", "type": "string" },
              "to": { "description": "Ziel-Telefonnummer.", "type": "string" },
              "from": { "description": "Absendende Telefonnummer.", "type": "string" },
              "status": { "description": "Aktueller Anruf-Status.", "type": "string", "enum": ["queued", "ringing", "in-progress", "completed", "failed", "busy", "no-answer", "canceled"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.call.ended" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["call_id", "status", "ts"],
            "properties": {
              "call_id": { "description": "Eindeutige Anruf-ID.", "type": "string" },
              "status": { "description": "Endgueltiger Anruf-Status.", "type": "string" },
              "duration_sec": { "description": "Gespraechsdauer in Sekunden.", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.call.status" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["call_id", "to", "from", "status", "ts"],
            "properties": {
              "call_id": { "description": "Eindeutige Anruf-ID.", "type": "string" },
              "to": { "description": "Ziel-Telefonnummer.", "type": "string" },
              "from": { "description": "Absendende Telefonnummer.", "type": "string" },
              "status": { "description": "Aktueller Anruf-Status.", "type": "string" },
              "duration_sec": { "description": "Gespraechsdauer in Sekunden.", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.automation.rule.triggered" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["rule_name", "event_method", "ts"],
            "properties": {
              "rule_name": { "description": "Name der ausgeloesten Event-Regel.", "type": "string" },
              "event_method": { "description": "Das ausloesende IPC-Event.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "event.ide.focus" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["filename", "path", "ts"],
            "properties": {
              "filename": { "description": "Name der aktiven Datei (Basename).", "type": "string" },
              "language": { "description": "Sprach-ID des Editors (z.B. go, typescript).", "type": "string" },
              "path": { "description": "Absoluter Pfad der aktiven Datei.", "type": "string" },
              "project": { "description": "Name des Workspace/Projekts.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.media.volume" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["volume"],
            "properties": {
              "volume": { "description": "Ziel-Lautstärke in Prozent (0-100).", "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.media.set_activity" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["activity_type", "name"],
            "properties": {
              "activity_type": { "description": "Discord-Aktivitaets-Typ (0=Playing, 2=Listening).", "type": "integer", "enum": [0, 2] },
              "name": { "description": "Name der Aktivitaet.", "type": "string" },
              "details": { "description": "Zusatzinformationen.", "type": "string" },
              "state": { "description": "Status-Text.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.automation.run" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["task"],
            "properties": {
              "task": { "description": "Name des auszuführenden Tasks (in der S-C-Konfiguration definiert).", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.metrics.set_interval" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["interval_ms"],
            "properties": {
              "interval_ms": { "description": "Neues Poll-Intervall für Systemmetriken in Millisekunden (0 = aus).", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.git.watch" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["path"],
            "properties": {
              "path": { "description": "Pfad des Git-Repos, das zusätzlich überwacht wird.", "type": "string" },
              "interval_ms": { "description": "Optional: Poll-Intervall für dieses Repo in Millisekunden (0/fehlend = Standard -git-interval).", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.clipboard.set" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["content"],
            "properties": {
              "content": { "description": "Der einzusetzende Clipboard-Inhalt.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.clipboard.get_history" } } },
      "then": {
        "properties": {
          "params": {
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.call.make" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["to"],
            "properties": {
              "to": { "description": "Ziel-Telefonnummer (E.164-Format).", "type": "string" },
              "url": { "description": "Optionale TwiML-URL fuer den Anruf.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.call.hangup" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["call_id"],
            "properties": {
              "call_id": { "description": "ID des zu beendenden Anrufs.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.call.status" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["call_id"],
            "properties": {
              "call_id": { "description": "ID des abzufragenden Anrufs.", "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "cmd.profile.switch" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["profile"],
            "properties": {
              "profile": { "description": "Ziel-Profil (dev, gaming, afk).", "type": "string", "enum": ["dev", "gaming", "afk"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "error.protocol" } } },
      "then": {
        "properties": {
          "params": {
            "required": ["code", "message", "ts"],
            "properties": {
              "code": { "description": "JSON-RPC-Fehlercode.", "type": "integer" },
              "message": { "description": "Kurze Fehlerbeschreibung.", "type": "string" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
